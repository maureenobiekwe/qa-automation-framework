{
  "info": {
    "name": "Demo API regression (JSONPlaceholder)",
    "description": "Public demo API only. Shows chaining, exact status codes and a per-run id. No secrets in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts: read",
      "item": [
        {
          "name": "TC-01 List posts returns 200 and 100 posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body is an array of 100\", () => { pm.expect(body).to.be.an(\"array\"); pm.expect(body.length).to.eql(100); });",
                  "pm.test(\"Each post has the required fields\", () => body.forEach(p => pm.expect(p).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\")));",
                  "pm.test(\"Responds in under 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "TC-02 Get one post and keep its userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const post = pm.response.json();",
                  "pm.test(\"Id matches the request\", () => pm.expect(post.id).to.eql(1));",
                  "pm.test(\"userId is a number\", () => pm.expect(post.userId).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"userId\", post.userId);",
                  "pm.test(\"Responds in under 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "TC-03 Author of that post exists (uses the saved userId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Author id equals the post userId\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"userId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "TC-04 Unknown post returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "999999"
              ]
            }
          }
        },
        {
          "name": "TC-05 Filter by userId only returns that user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All posts belong to user 1\", () => pm.response.json().forEach(p => pm.expect(p.userId).to.eql(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts?userId=1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts: write (the demo API fakes writes, so only the response is checked)",
      "item": [
        {
          "name": "TC-06 Create a post returns 201 and echoes the data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const created = pm.response.json();",
                  "pm.test(\"Title is echoed\", () => pm.expect(created.title).to.eql(\"qa-regression-\" + pm.collectionVariables.get(\"runId\")));",
                  "pm.test(\"An id is returned\", () => pm.expect(created.id).to.be.a(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"qa-regression-{{runId}}\", \"body\": \"test data only\", \"userId\": 1}"
            }
          }
        },
        {
          "name": "TC-07 Update a post returns 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"New title is returned\", () => pm.expect(pm.response.json().title).to.eql(\"updated title\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"id\": 1, \"title\": \"updated title\", \"body\": \"test data only\", \"userId\": 1}"
            }
          }
        },
        {
          "name": "TC-08 Delete a post returns 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ]
}